TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
HROMI_BASE_URL=http://127.0.0.1:8091
HROMI_PUBLIC_API_KEY=replace-with-the-same-32-character-key-as-backend

# Required comma-separated Telegram user IDs; empty denies access.
TELEGRAM_ALLOWED_USER_IDS=
# Explicit opt-in for a public bot. Daily and queue limits remain enforced.
TELEGRAM_ALLOW_ANY_USER=0
# Default: private chats only. Explicit group IDs may be allowed.
TELEGRAM_ALLOWED_GROUP_IDS=
TELEGRAM_MAX_ACTIVE_PHOTOS=20
# 0 disables the per-user daily photo limit.
TELEGRAM_DAILY_PHOTOS_PER_USER=0

HROMI_POLL_INTERVAL_SECONDS=2
TELEGRAM_POLL_SECONDS=30
TELEGRAM_MAX_PHOTO_BYTES=8388608
TELEGRAM_MONITOR_WORKERS=20
TELEGRAM_BOT_DB=./data/telegram-bot.sqlite3
